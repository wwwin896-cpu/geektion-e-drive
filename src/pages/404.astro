---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
	<main class="container mx-auto flex min-h-[60vh] flex-col items-center justify-center p-4 py-24 text-center">
		<p class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-industrialOrange">Error 404</p>
		<h1 class="mb-6 text-6xl font-bold tracking-tighter text-white md:text-8xl">Route not found.</h1>
		<p class="mb-10 max-w-xl text-lg opacity-70">This Geektion page is unavailable, but our E-Drive systems and OEM solutions are ready to explore.</p>
		<div class="flex flex-wrap justify-center gap-4">
			<a href="/" class="bg-white px-8 py-4 font-bold uppercase tracking-widest text-graphite transition-colors hover:bg-cyberBlue hover:text-white">Back to Home</a>
			<a href="/contact" class="border border-white px-8 py-4 font-bold uppercase tracking-widest text-white transition-colors hover:border-industrialOrange hover:text-industrialOrange">Contact Geektion</a>
		</div>
	</main>
</Layout>
