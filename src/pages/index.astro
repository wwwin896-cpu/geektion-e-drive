---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Geektion — High Performance E-Drive Systems & OEM Solutions">
	<main>
		<!-- Hero: Focus on E-Drive -->
		<section class="relative isolate flex min-h-[640px] h-[calc(100svh-72px)] max-h-[920px] flex-col justify-center items-center overflow-hidden bg-graphite p-4 text-center">
			<img src="/images/home-coastal-banner.jpg" alt="Electric bicycle rider cruising a coastal road at sunset" class="absolute inset-0 h-full w-full object-cover object-center" fetchpriority="high" />
			<div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/50 to-graphite/95"></div>
			<div class="absolute inset-0 bg-gradient-to-r from-black/65 via-transparent to-black/35"></div>
			<div class="relative z-10 flex flex-col items-center">
			<h1 class="text-6xl md:text-8xl font-bold tracking-tighter mb-6">
				ENGINEERED TO <br/> <span class="text-cyberBlue italic">REDEFINE</span> PERFORMANCE
			</h1>
			<p class="max-w-2xl text-lg md:text-xl opacity-80 mb-10 font-light">
				High-performance Geektion E-Drive systems and OEM solutions for the next generation of eBikes.
				B2B partner for global brands and wholesalers.
			</p>
			<div class="flex gap-4">
				<a href="/solutions/drive-system" class="px-8 py-4 bg-white text-graphite font-bold uppercase tracking-widest hover:bg-cyberBlue hover:text-white transition-all">
					Explore Tech
				</a>
				<a href="/solutions/parts-oem" class="px-8 py-4 border border-white font-bold uppercase tracking-widest hover:border-industrialOrange hover:text-industrialOrange transition-all">
					OEM Services
				</a>
			</div>
			</div>
		</section>

		<!-- E-Drive Ecosystem: 3 pillars (no eBike) -->
		<section class="container mx-auto p-4 py-20">
			<div class="text-center mb-16">
				<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">The Geektion Ecosystem</h3>
				<h2 class="text-4xl md:text-5xl font-bold tracking-tighter uppercase">E-Drive. Energy. Engineering.</h2>
			</div>
			<div class="grid md:grid-cols-3 gap-8">
				<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
					<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Core System</h3>
					<h2 class="text-3xl font-bold tracking-tighter mb-4">Geektion E-Drive</h2>
					<p class="opacity-60 mb-6 text-sm leading-relaxed">Micro mid-drive motors engineered for stealth integration. 2.4kg system weight, 45-60Nm in-runner torque, and precision reduction gearing for the folding & urban segment.</p>
					<a href="/solutions/drive-system" class="text-xs uppercase tracking-widest font-bold group-hover:underline">Technical Specs &rarr;</a>
				</div>
				<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
					<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Energy Solutions</h3>
					<h2 class="text-3xl font-bold tracking-tighter mb-4">Battery &amp; Energy</h2>
					<p class="opacity-60 mb-6 text-sm leading-relaxed">Decoupled battery architecture. 100Wh IATA-compliant cells that detach in seconds and double as a USB-C power bank — freedom to ride, fly, and charge anywhere.</p>
					<a href="/solutions/drive-system" class="text-xs uppercase tracking-widest font-bold group-hover:underline">Energy Hub &rarr;</a>
				</div>
				<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
					<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Partner Programs</h3>
					<h2 class="text-3xl font-bold tracking-tighter mb-4">OEM &amp; Certification</h2>
					<p class="opacity-60 mb-6 text-sm leading-relaxed">Global compliance (EN15194, UL2849, UN38.3) with full OEM/ODM customization — firmware tuning, housing design, and STEP-file engineering support for brand partners.</p>
					<a href="/solutions/parts-oem" class="text-xs uppercase tracking-widest font-bold group-hover:underline">Manufacturing &rarr;</a>
				</div>
			</div>
		</section>

		<!-- Latest Insights -->
		<section class="container mx-auto p-4 py-20 border-t border-white/10">
			<div class="flex justify-between items-end mb-12">
				<div>
					<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Innovation Hub</h3>
					<h2 class="text-4xl font-bold uppercase tracking-tighter">Latest Insights</h2>
				</div>
				<a href="/insights" class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1 hover:text-cyberBlue hover:border-cyberBlue transition-colors">View All &rarr;</a>
			</div>
			
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<a href="/insights/invisible-power" class="group block border border-white/10 hover:border-cyberBlue transition-colors overflow-hidden">
					<div class="hidden" aria-hidden="true"></div>
					<div class="p-8">
						<h4 class="text-xl font-bold tracking-tighter mb-4 uppercase">Invisible Power: Future of Folding eBikes</h4>
						<p class="opacity-60 text-xs mb-4">How micro-integration is shifting the B2B landscape.</p>
						<span class="text-cyberBlue text-[10px] font-bold uppercase tracking-widest">Read More</span>
					</div>
				</a>

				<a href="/insights/in-runner-vs-out-runner" class="group block border border-white/10 hover:border-cyberBlue transition-colors overflow-hidden">
					<div class="hidden" aria-hidden="true"></div>
					<div class="p-8">
						<h4 class="text-xl font-bold tracking-tighter mb-4 uppercase">The Secret of In-runner Propulsion</h4>
						<p class="opacity-60 text-xs mb-4">Internal rotor architecture for high-torque systems.</p>
						<span class="text-cyberBlue text-[10px] font-bold uppercase tracking-widest">Read More</span>
					</div>
				</a>

				<a href="/insights/flight-safe-energy-hub" class="group block border border-white/10 hover:border-cyberBlue transition-colors overflow-hidden">
					<div class="hidden" aria-hidden="true"></div>
					<div class="p-8">
						<h4 class="text-xl font-bold tracking-tighter mb-4 uppercase">The Flight-Safe Energy Hub</h4>
						<p class="opacity-60 text-xs mb-4">IATA-compliant batteries for the global nomad.</p>
						<span class="text-cyberBlue text-[10px] font-bold uppercase tracking-widest">Read More</span>
					</div>
				</a>
			</div>
		</section>
	</main>
</Layout>
