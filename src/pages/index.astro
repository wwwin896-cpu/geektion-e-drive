---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<main>
		<section class="h-[80vh] flex flex-col justify-center items-center text-center p-4">
			<h1 class="text-6xl md:text-8xl font-bold tracking-tighter mb-6">
				ENGINEERED TO <br/> <span class="text-cyberBlue italic">REDEFINE</span> PERFORMANCE
			</h1>
			<p class="max-w-2xl text-lg md:text-xl opacity-80 mb-10 font-light">
				High-performance drive systems and OEM solutions for the next generation of eBikes. 
				B2B partner for global brands and wholesalers.
			</p>
			<div class="flex gap-4">
				<a href="/solutions/drive-system" class="px-8 py-4 bg-white text-graphite font-bold uppercase tracking-widest hover:bg-cyberBlue hover:text-white transition-all">
					Explore Tech
				</a>
				<a href="/solutions/parts-oem" class="px-8 py-4 border border-white font-bold uppercase tracking-widest hover:border-industrialOrange hover:text-industrialOrange transition-all">
					OEM Services
				</a>
			</div>
		</section>

		<section class="container mx-auto grid md:grid-cols-3 gap-8 p-4 py-20">
			<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
				<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Pillar 01</h3>
				<h2 class="text-3xl font-bold tracking-tighter mb-4">eBike Portfolio</h2>
				<p class="opacity-60 mb-6 text-sm">Full-bike solutions ranging from urban commuters to high-performance mountain bikes.</p>
				<a href="/solutions/ebike" class="text-xs uppercase tracking-widest font-bold group-hover:underline">View Collection &rarr;</a>
			</div>
			<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
				<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Pillar 02</h3>
				<h2 class="text-3xl font-bold tracking-tighter mb-4">Geektion E-Drive</h2>
				<p class="opacity-60 mb-6 text-sm">Torque-rich motors, high-density batteries, and intelligent human-machine interfaces.</p>
				<a href="/solutions/drive-system" class="text-xs uppercase tracking-widest font-bold group-hover:underline">Technical Specs &rarr;</a>
			</div>
			<div class="border border-white/10 p-8 hover:border-cyberBlue transition-colors group">
				<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Pillar 03</h3>
				<h2 class="text-3xl font-bold tracking-tighter mb-4">Parts OEM</h2>
				<p class="opacity-60 mb-6 text-sm">Precision manufacturing for brands. From frame forging to advanced CNC components.</p>
				<a href="/solutions/parts-oem" class="text-xs uppercase tracking-widest font-bold group-hover:underline">Manufacturing &rarr;</a>
			</div>
		<section class="container mx-auto p-4 py-20 border-t border-white/10">
			<div class="flex justify-between items-end mb-12">
				<div>
					<h3 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-4 font-bold">Innovation Hub</h3>
					<h2 class="text-4xl font-bold uppercase tracking-tighter">Latest Insights</h2>
				</div>
				<a href="/insights" class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1 hover:text-cyberBlue hover:border-cyberBlue transition-colors">View All &rarr;</a>
			</div>
			
			<div class="grid md:grid-cols-2 gap-8">
				<a href="/insights/invisible-power" class="group block border border-white/10 hover:border-cyberBlue transition-colors overflow-hidden">
					<div class="aspect-video relative bg-black">
						<img 
							src="https://sc02.alicdn.com/kf/Hcf37d3724b23406fa2013ac5c23c43eaK.jpg" 
							alt="Invisible Power" 
							class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
					<div class="p-8">
						<h4 class="text-2xl font-bold tracking-tighter mb-4">Invisible Power: The Future of Premium Folding eBike Drive Systems</h4>
						<p class="opacity-60 text-sm mb-4">How micro-integration is shifting the B2B landscape for travel-ready eBikes.</p>
						<span class="text-cyberBlue text-xs font-bold uppercase tracking-widest">Read More</span>
					</div>
				</a>

				<a href="/insights/in-runner-vs-out-runner" class="group block border border-white/10 hover:border-cyberBlue transition-colors overflow-hidden">
					<div class="aspect-video relative bg-black">
						<img 
							src="https://sc02.alicdn.com/kf/Hf266ae051859445ea46b0345a0f8fefah.jpg" 
							alt="In-runner Technology" 
							class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
						/>
					</div>
					<div class="p-8">
						<h4 class="text-2xl font-bold tracking-tighter mb-4">In-runner vs. Out-runner: The Future of eBike Propulsion</h4>
						<p class="opacity-60 text-sm mb-4">Why internal rotor architecture is the secret behind high-torque systems.</p>
						<span class="text-cyberBlue text-xs font-bold uppercase tracking-widest">Read More</span>
					</div>
				</a>
			</div>
		</section>
	</main>
</Layout>
