---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Insights & News">
	<main class="container mx-auto p-4 py-20">
		<h1 class="text-5xl font-bold mb-12 uppercase tracking-tighter">Technical <span class="text-cyberBlue">Insights</span></h1>
		
		<div class="grid md:grid-cols-2 gap-12">
			<a href="/insights/invisible-power" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/Hcf37d3724b23406fa2013ac5c23c43eaK.jpg" 
						alt="Invisible Power" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Industry Analysis</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter">Invisible Power: The Future of Premium Folding eBike Drive Systems</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">Discover how micro mid-drive integration and flight-safe battery technology are redefining urban mobility and travel-friendly eBikes.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/in-runner-vs-out-runner" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/Hf266ae051859445ea46b0345a0f8fefah.jpg" 
						alt="In-runner Technology" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Engineering Deep-Dive</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter">In-runner vs. Out-runner: Engineering the Future of eBike Propulsion</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">A technical comparison of motor architectures and why internal rotors dominate high-torque mid-drive systems.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>
			
			<!-- Future insights can be added here -->
		</div>
	</main>
</Layout>
