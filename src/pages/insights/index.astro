---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Insights & News">
	<main class="container mx-auto p-4 py-20">
		<h1 class="text-5xl font-bold mb-12 uppercase tracking-tighter">Technical <span class="text-cyberBlue">Insights</span></h1>
		
		<div class="grid md:grid-cols-2 gap-12">
			<a href="/insights/ebike-motor-weight-comparison" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/H32aa18d37e0549fdbb8dee5abf18e49ab.jpg" 
						alt="eBike motor weight comparison" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Technical Benchmark</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter uppercase">The Complete eBike Motor Weight Comparison: Why Lightweight Wins</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">A data-driven benchmark of the lightest mid-drive motors, from Geektion to Bosch, Shimano and Bafang.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/folding-bike-battery-integration" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/H7796d5fc2bfe40e8a97eab01fd962cafy.jpg" 
						alt="folding bike battery integration" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Design Engineering</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter uppercase">Folding Bike Battery Integration: Design Principles for a Clean Fold</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">Weight distribution, fold clearance, and modular detachment—the three principles that make or break the platform.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/choosing-mid-drive-for-folding-bikes" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/H1ed28ff0c43f4948ac6d4621addc1ce4v.jpg" 
						alt="Mid-drive motor for folding bike" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">B2B Buying Guide</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter uppercase">How to Choose the Perfect Mid-Drive Motor for a Folding eBike</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">A practical selection framework covering weight, torque, integration, and certification for the folding platform.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/invisible-power" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/Hcf37d3724b23406fa2013ac5c23c43eaK.jpg" 
						alt="Invisible Power" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Industry Analysis</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter">Invisible Power: The Future of Premium Folding eBike Drive Systems</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">Discover how micro mid-drive integration and flight-safe battery technology are redefining urban mobility and travel-friendly eBikes.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/in-runner-vs-out-runner" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/Hf266ae051859445ea46b0345a0f8fefah.jpg" 
						alt="In-runner Technology" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Engineering Deep-Dive</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter uppercase">In-runner vs. Out-runner: Engineering the Future of eBike Propulsion</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">A technical comparison of motor architectures and why internal rotors dominate high-torque mid-drive systems.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>

			<a href="/insights/flight-safe-energy-hub" class="group block border border-white/10 overflow-hidden hover:border-cyberBlue transition-colors">
				<div class="aspect-video relative bg-black">
					<img 
						src="https://sc02.alicdn.com/kf/H6ff983140d284c078c0c355d88109ff14.jpg" 
						alt="Flight Safe Energy Hub" 
						class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
					/>
				</div>
				<div class="p-8">
					<h3 class="text-xs uppercase tracking-widest text-cyberBlue mb-4 font-bold">Innovation Focus</h3>
					<h2 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors tracking-tighter uppercase">The Flight-Safe Energy Hub: Redefining Global eBike Mobility</h2>
					<p class="opacity-60 text-sm mb-6 leading-relaxed">How IATA-compliant modular batteries are solving travel restrictions for digital nomads and global brands.</p>
					<span class="text-xs uppercase font-bold tracking-widest border-b border-white pb-1">Read Article &rarr;</span>
				</div>
			</a>
			
			<!-- Future insights can be added here -->
		</div>
	</main>
</Layout>
