---
import Layout from '../layouts/Layout.astro';
---

<Layout title="B2B Contact & Inquiry">
	<main class="container mx-auto p-4 py-20">
		<div class="max-w-4xl mx-auto">
			<h1 class="text-5xl font-space font-bold mb-8 uppercase tracking-tighter">B2B <span class="text-cyberBlue">Inquiry</span></h1>
			<p class="text-xl opacity-60 mb-16">Connect with our engineering and sales teams for custom eBike solutions, drive system integration, or OEM manufacturing inquiries.</p>
			
			<div class="grid md:grid-cols-2 gap-16">
				<div class="space-y-12">
					<div>
						<h3 class="text-industrialOrange font-mono text-sm uppercase tracking-widest font-bold mb-4">Direct Communication</h3>
						<p class="text-2xl font-space font-bold text-white mb-2">info@geektion.com</p>
						<p class="opacity-50 text-sm">Response time: Within 24 hours (Business Days)</p>
					</div>
					
					<div>
						<h3 class="text-industrialOrange font-mono text-sm uppercase tracking-widest font-bold mb-4">Global Headquarters</h3>
						<p class="text-white opacity-80 leading-relaxed mb-8">
							Geektion Technology Hub<br/>
							High-Tech Industrial Park<br/>
							Shenzhen, China
						</p>

						<h3 class="text-industrialOrange font-mono text-sm uppercase tracking-widest font-bold mb-4">Connect With Us</h3>
						<div class="flex space-x-6 text-silver/60">
							<a href="https://facebook.com/geektion" target="_blank" class="hover:text-cyberBlue transition-colors">Facebook</a>
							<a href="https://linkedin.com/company/geektion" target="_blank" class="hover:text-cyberBlue transition-colors">LinkedIn</a>
							<a href="https://instagram.com/geektion" target="_blank" class="hover:text-cyberBlue transition-colors">Instagram</a>
						</div>
					</div>
				</div>
				
				<div class="bg-white/5 p-8 border border-white/10">
					<h3 class="text-xl font-space font-bold mb-6">Quick Inquiry</h3>
					<form class="space-y-4">
						<div>
							<label class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Company Name</label>
							<input type="text" placeholder="Your Brand Name" class="w-full bg-graphite border border-white/10 p-3 text-sm focus:border-cyberBlue outline-none transition-colors" />
						</div>
						<div>
							<label class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Company Email</label>
							<input type="email" placeholder="name@company.com" class="w-full bg-graphite border border-white/10 p-3 text-sm focus:border-cyberBlue outline-none transition-colors" />
						</div>
						<div>
							<label class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Estimated Annual Volume</label>
							<select class="w-full bg-graphite border border-white/10 p-3 text-sm focus:border-cyberBlue outline-none transition-colors">
								<option>50 - 200 units</option>
								<option>200 - 1000 units</option>
								<option>1000 - 5000 units</option>
								<option>5000+ units</option>
							</select>
						</div>
						<div>
							<label class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Inquiry Type</label>
							<select class="w-full bg-graphite border border-white/10 p-3 text-sm focus:border-cyberBlue outline-none transition-colors">
								<option>Geektion E-Drive Integration</option>
								<option>eBike White-label Portfolio</option>
								<option>Parts OEM / Manufacturing</option>
							</select>
						</div>
						<div>
							<label class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Message</label>
							<textarea rows="4" class="w-full bg-graphite border border-white/10 p-3 text-sm focus:border-cyberBlue outline-none transition-colors"></textarea>
						</div>
						<button type="button" class="w-full py-4 bg-cyberBlue text-white font-bold uppercase tracking-widest hover:bg-white hover:text-graphite transition-all">Submit Inquiry</button>
					</form>
				</div>
			</div>
		</div>
	</main>
</Layout>
