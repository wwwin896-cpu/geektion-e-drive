---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Technology & Innovation">
	<main class="container mx-auto p-4 py-20">
		<h1 class="text-5xl font-bold mb-12 uppercase tracking-tighter text-white">Engineering <span class="text-cyberBlue">Excellence</span></h1>
		
		<!-- Technology Section 1: Micro Mid-Drive -->
		<section class="grid lg:grid-cols-2 gap-16 items-center mb-32">
			<div>
				<h3 class="text-xs uppercase tracking-[0.2em] text-industrialOrange mb-4 font-bold">Propulsion Tech</h3>
				<h2 class="text-4xl font-bold tracking-tighter mb-6 uppercase">Integrated Micro <br/> Mid-Drive Propulsion</h2>
				<p class="opacity-70 leading-relaxed mb-8 text-lg">
					By integrating the motor, controller, and gearing into a single compact unit within the bottom bracket, we achieve the most space-efficient propulsion system for small and light electric vehicles.
				</p>
				<div class="grid grid-cols-2 gap-8 mb-8">
					<div class="border-l-2 border-cyberBlue pl-4">
						<div class="text-2xl font-bold tracking-tighter text-white">92%</div>
						<div class="text-xs opacity-50 uppercase tracking-widest">Peak Efficiency</div>
					</div>
					<div class="border-l-2 border-cyberBlue pl-4">
						<div class="text-2xl font-bold tracking-tighter text-white">60Nm</div>
						<div class="text-xs opacity-50 uppercase tracking-widest">Max Torque</div>
					</div>
				</div>
				<p class="text-sm opacity-50 italic font-mono leading-relaxed">Patented Multiphase Modular Architecture</p>
			</div>
			<div class="aspect-square bg-white/5 border border-white/10 flex items-center justify-center relative overflow-hidden group">
				<span class="text-xs uppercase tracking-widest opacity-30 group-hover:opacity-100 transition-opacity">Technical Render: Motor X1</span>
				<!-- Background Grid Effect -->
				<div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle, #00A3FF 1px, transparent 1px); background-size: 20px 20px;"></div>
			</div>
		</section>

		<!-- Technology Section 2: Flight-Safe Battery -->
		<section class="grid lg:grid-cols-2 gap-16 items-center mb-32">
			<div class="lg:order-2">
				<h3 class="text-xs uppercase tracking-[0.2em] text-industrialOrange mb-4 font-bold">Energy Management</h3>
				<h2 class="text-4xl font-bold tracking-tighter mb-6 uppercase">Smart Aviation-Ready <br/> Energy Solutions</h2>
				<p class="opacity-70 leading-relaxed mb-8 text-lg">
					Our battery technology is focused on safety, modularity, and high energy density. The "Independent Hub" design allows for multi-purpose use while strictly adhering to global aviation safety standards.
				</p>
				<ul class="space-y-4 text-sm opacity-70">
					<li class="flex items-center gap-3">
						<span class="w-1.5 h-1.5 bg-cyberBlue rounded-full"></span>
						IATA Compliant Modular Design
					</li>
					<li class="flex items-center gap-3">
						<span class="w-1.5 h-1.5 bg-cyberBlue rounded-full"></span>
						BMS with Real-time Thermal Monitoring
					</li>
					<li class="flex items-center gap-3">
						<span class="w-1.5 h-1.5 bg-cyberBlue rounded-full"></span>
						Integrated USB-C Power Delivery (PD)
					</li>
				</ul>
			</div>
			<div class="lg:order-1 aspect-video bg-white/5 border border-white/10 flex items-center justify-center group relative overflow-hidden">
				<span class="text-xs uppercase tracking-widest opacity-30 group-hover:opacity-100 transition-opacity">Technical Render: Battery B1</span>
				<div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: linear-gradient(0deg, #00A3FF 1px, transparent 1px); background-size: 100% 40px;"></div>
			</div>
		</section>

		<!-- Technical Specs Table -->
		<section class="py-20 border-t border-white/10">
			<h2 class="text-3xl font-bold tracking-tighter mb-12 uppercase">System <span class="text-cyberBlue">Benchmarks</span></h2>
			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="border-b border-white/20 text-[10px] uppercase tracking-widest opacity-50">
							<th class="py-4 font-bold">Parameter</th>
							<th class="py-4 font-bold text-cyberBlue">Geektion Drive G1</th>
							<th class="py-4 font-bold">Industry Standard</th>
						</tr>
					</thead>
					<tbody class="text-sm font-mono opacity-80">
						<tr class="border-b border-white/5">
							<td class="py-6">System Weight</td>
							<td class="py-6 text-cyberBlue">2.4 kg</td>
							<td class="py-6">3.5 - 4.2 kg</td>
						</tr>
						<tr class="border-b border-white/5">
							<td class="py-6">Energy Density</td>
							<td class="py-6 text-cyberBlue">250 Wh/kg</td>
							<td class="py-6">180 - 210 Wh/kg</td>
						</tr>
						<tr class="border-b border-white/5">
							<td class="py-6">Ingress Protection</td>
							<td class="py-6 text-cyberBlue">IP67</td>
							<td class="py-6">IP54 / IP65</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</main>
</Layout>
