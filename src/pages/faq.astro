---
import Layout from '../layouts/Layout.astro';

const faqs = [
	{
		q: "What is the Minimum Order Quantity (MOQ) for Geektion E-Drive systems?",
		a: "For our standard G-Series and C-Series systems, the MOQ starts at 50 units. For fully customized OEM projects, the MOQ typically starts at 200 units depending on the level of customization."
	},
	{
		q: "What is the typical lead time for mass production?",
		a: "Standard products usually have a lead time of 4-6 weeks. Custom OEM projects require 8-12 weeks from final prototype approval to mass production shipping."
	},
	{
		q: "Are your battery systems flight-safe and IATA compliant?",
		a: "Yes, our Independent Energy Hub is specifically designed with 100Wh modular cells that comply with IATA regulations for cabin luggage. We provide all necessary UN38.3 certification for global logistics."
	},
	{
		q: "Do you provide technical support for frame integration?",
		a: "Absolutely. We provide 3D STEP files and detailed CAD drawings for all motors. Our engineering team can also provide consultation on bottom bracket modifications and cable routing."
	},
	{
		q: "What is your warranty policy for B2B partners?",
		a: "We offer a standard 24-month warranty on drive units and a 12-month warranty on battery cells. We also provide a 1% spare parts buffer for bulk orders to ensure immediate local serviceability."
	}
];
---

<Layout title="Procurement FAQ | Geektion B2B Solutions">
	<main class="container mx-auto p-4 py-20 max-w-4xl">
		<h1 class="text-5xl font-space font-bold mb-12 uppercase tracking-tighter">Procurement <span class="text-cyberBlue">FAQ</span></h1>
		<p class="text-xl opacity-60 mb-16">Everything you need to know about partnering with Geektion for your eBike brand.</p>
		
		<div class="space-y-12">
			{faqs.map((faq) => (
				<div class="border-b border-white/10 pb-12">
					<h3 class="text-2xl font-space font-bold mb-4 text-white">Q: {faq.q}</h3>
					<p class="opacity-70 leading-relaxed text-lg">A: {faq.a}</p>
				</div>
			))}
		</div>

		<section class="mt-20 p-12 bg-industrialOrange/10 border border-industrialOrange/20">
			<h2 class="text-2xl font-space font-bold mb-4 text-industrialOrange">Still have questions?</h2>
			<p class="opacity-70 mb-8">Contact our sales team directly for a tailored quotation or sample request.</p>
			<a href="/contact" class="inline-block px-8 py-4 bg-industrialOrange text-white font-bold uppercase tracking-widest">Contact Sales</a>
		</section>
	</main>
</Layout>
