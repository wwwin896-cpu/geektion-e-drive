---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Manufacturer Portal | OEM & ODM Integration">
	<main class="container mx-auto p-4 py-20">
		<header class="max-w-4xl mb-32">
			<h3 class="text-industrialOrange font-bold text-xs uppercase tracking-widest mb-4">Manufacturer Support</h3>
			<h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-white uppercase mb-8">Integrated <br/> <span class="text-industrialOrange italic">Partnership</span></h1>
			<p class="text-xl opacity-60 leading-relaxed max-w-2xl">A dedicated environment for bike brands and engineers. Access technical assets, compliance data, and integration manuals to accelerate your product development.</p>
		</header>

		<!-- Comparison Matrix -->
		<section class="mb-40">
			<h2 class="text-3xl font-bold tracking-tighter text-white mb-12 uppercase">Competitive <span class="text-cyberBlue">Benchmarks</span></h2>
			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse border border-white/10">
					<thead>
						<tr class="bg-white/5 text-[10px] uppercase tracking-widest opacity-50">
							<th class="p-6 border-b border-white/10">Metric</th>
							<th class="p-6 border-b border-white/10 text-cyberBlue">Geektion MSU</th>
							<th class="p-6 border-b border-white/10">Market Standard A</th>
							<th class="p-6 border-b border-white/10">Market Standard B</th>
						</tr>
					</thead>
					<tbody class="text-sm font-mono opacity-80">
						<tr class="border-b border-white/10">
							<td class="p-6">System Weight</td>
							<td class="p-6 text-cyberBlue">2.4 kg</td>
							<td class="p-6">3.8 kg</td>
							<td class="p-6">4.2 kg</td>
						</tr>
						<tr class="border-b border-white/10">
							<td class="p-6">Logistics / Flight</td>
							<td class="p-6 text-cyberBlue">IATA Compliant (100Wh)</td>
							<td class="p-6">Restricted (400Wh+)</td>
							<td class="p-6">Restricted (500Wh+)</td>
						</tr>
						<tr class="border-b border-white/10">
							<td class="p-6">Stealth Factor</td>
							<td class="p-6 text-cyberBlue">Integrated BB (Invisible)</td>
							<td class="p-6">External Frame Mount</td>
							<td class="p-6">Internal Downtube (Wide)</td>
						</tr>
						<tr class="border-b border-white/10">
							<td class="p-6">Connectivity</td>
							<td class="p-6 text-cyberBlue">Cloud-native OTA</td>
							<td class="p-6">Dealer-only Updates</td>
							<td class="p-6">Wired-only Service</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<!-- Asset Library -->
		<section class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-40">
			<div class="p-12 border border-white/10 bg-white/5 hover:border-industrialOrange transition-all flex flex-col h-full">
				<div class="mb-8 opacity-20">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
				</div>
				<h3 class="text-2xl font-bold tracking-tighter text-white mb-4 uppercase">STEP Files</h3>
				<p class="text-sm opacity-60 leading-relaxed mb-10 flex-grow">Full 3D CAD data for all drive units, batteries, and display mounts. Ready for rapid frame integration.</p>
				<span class="text-[10px] uppercase font-bold tracking-widest text-industrialOrange border-b border-industrialOrange/30 pb-1 w-fit">Request Access &rarr;</span>
			</div>

			<div class="p-12 border border-white/10 bg-white/5 hover:border-industrialOrange transition-all flex flex-col h-full">
				<div class="mb-8 opacity-20">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
				</div>
				<h3 class="text-2xl font-bold tracking-tighter text-white mb-4 uppercase">Technical Manuals</h3>
				<p class="text-sm opacity-60 leading-relaxed mb-10 flex-grow">Detailed assembly protocols, wiring diagrams, and torque specifications for mass production lines.</p>
				<span class="text-[10px] uppercase font-bold tracking-widest text-industrialOrange border-b border-industrialOrange/30 pb-1 w-fit">Request Access &rarr;</span>
			</div>

			<div class="p-12 border border-white/10 bg-white/5 hover:border-industrialOrange transition-all flex flex-col h-full">
				<div class="mb-8 opacity-20">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><polyline points="20 17 20 20 4 20 4 17"></polyline></svg>
				</div>
				<h3 class="text-2xl font-bold tracking-tighter text-white mb-4 uppercase">API Documentation</h3>
				<p class="text-sm opacity-60 leading-relaxed mb-10 flex-grow">Geektion Cloud and BLE protocols for white-label app developers and fleet management software.</p>
				<span class="text-[10px] uppercase font-bold tracking-widest text-industrialOrange border-b border-industrialOrange/30 pb-1 w-fit">Request Access &rarr;</span>
			</div>
		</section>

		<!-- Integration Workflow -->
		<section class="p-12 bg-white/5 border border-white/10 text-center">
			<h2 class="text-3xl font-bold tracking-tighter mb-6 uppercase">Begin Your <span class="text-industrialOrange italic">Integration</span></h2>
			<p class="max-w-2xl mx-auto opacity-70 mb-10 leading-relaxed">Our engineering team is ready to assist your R&D department. From rapid prototyping to compliance certification, we provide the backbone for your success.</p>
			<div class="flex flex-wrap justify-center gap-6">
				<a href="/contact" class="px-10 py-5 bg-industrialOrange text-white font-bold uppercase tracking-widest hover:bg-white hover:text-industrialOrange transition-all tracking-tighter">Consult with Engineers</a>
			</div>
		</section>
	</main>
</Layout>
