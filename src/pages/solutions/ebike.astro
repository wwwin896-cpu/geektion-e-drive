---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="eBike Portfolio">
	<main class="container mx-auto p-4 py-20">
		<h1 class="text-5xl font-space font-bold mb-12 uppercase tracking-tighter">eBike <span class="text-cyberBlue">Portfolio</span></h1>
		<div class="grid md:grid-cols-2 gap-12">
			<div class="bg-white/5 aspect-video flex items-center justify-center border border-white/10">
				<span class="text-xs uppercase tracking-widest opacity-30">Render: Urban Series G1</span>
			</div>
			<div>
				<h2 class="text-3xl font-space font-bold mb-6">Urban & Commuter</h2>
				<p class="opacity-70 mb-8">Integrated design for seamless city mobility. Lightweight frames paired with our high-efficiency Drive 60 system.</p>
				<ul class="space-y-4">
					<li class="flex justify-between border-b border-white/10 pb-2">
						<span class="text-xs uppercase opacity-50">Range</span>
						<span class="font-mono text-cyberBlue">Up to 100km</span>
					</li>
					<li class="flex justify-between border-b border-white/10 pb-2">
						<span class="text-xs uppercase opacity-50">Weight</span>
						<span class="font-mono text-cyberBlue">15.5 kg</span>
					</li>
				</ul>
			</div>
		</div>
	</main>
</Layout>
