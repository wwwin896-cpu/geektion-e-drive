---
import Layout from '../../../layouts/Layout.astro';
import ProductDetailModules from '../../../components/ProductDetailModules.astro';

const lifestyle = Array.from({ length: 8 }, (_, index) => `/images/products/folding-city/lifestyle_${String(index + 1).padStart(2, '0')}.png`);
---

<Layout title="Bamboo Flute | Geektion eBike Portfolio">
	<main class="container mx-auto p-4 py-20">
		<!-- Back link -->
		<a href="/solutions/ebike" class="inline-block text-xs uppercase tracking-widest opacity-50 hover:text-cyberBlue transition-colors mb-8">&larr; Back to Portfolio</a>

		<!-- Hero -->
		<section class="mb-16 border border-white/10 overflow-hidden relative">
			<img
				src="/images/scenes/scene_01_hero.webp"
				alt="Folding ebike with mid-drive motor carried into metro – Bamboo Flute by Geektion"
				class="w-full h-[380px] md:h-[520px] object-cover"
				loading="eager"
			/>
			<div class="absolute bottom-0 left-0 p-8 md:p-12">
				<h3 class="text-cyberBlue font-bold text-xs uppercase tracking-widest mb-3">Folding Commuter</h3>
				<h1 class="text-5xl md:text-7xl font-bold tracking-tighter uppercase text-white">Bamboo Flute</h1>
				<p class="text-sm uppercase tracking-widest opacity-70 mt-2">Matte Grey</p>
			</div>
		</section>

		<!-- Spec strip -->
		<section class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 border border-white/10 mb-16">
			<div class="bg-graphite p-6">
				<span class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Wheel Size</span>
				<span class="font-mono text-cyberBlue font-bold">18"</span>
			</div>
			<div class="bg-graphite p-6">
				<span class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Motor</span>
				<span class="font-mono text-cyberBlue font-bold">Micro Mid-Drive</span>
			</div>
			<div class="bg-graphite p-6">
				<span class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Torque</span>
				<span class="font-mono text-cyberBlue font-bold">45 - 60 Nm *</span>
			</div>
			<div class="bg-graphite p-6">
				<span class="block text-[10px] uppercase tracking-widest opacity-50 mb-2">Battery</span>
				<span class="font-mono text-cyberBlue font-bold">100Wh IATA</span>
			</div>
		</section>
		<p class="text-[10px] uppercase tracking-widest opacity-40 mb-16 font-mono">* Series reference value — final specs tuned per OEM project.</p>

		<!-- Key Highlights -->
		<section class="mb-16">
			<h2 class="text-xs uppercase tracking-[0.2em] text-cyberBlue mb-6 font-bold">Key Highlights</h2>
			<div class="grid sm:grid-cols-2 gap-4">
				<div class="border border-white/10 p-4 bg-white/5"><span class="text-sm leading-relaxed">• Folds in under 3 seconds</span></div>
				<div class="border border-white/10 p-4 bg-white/5"><span class="text-sm leading-relaxed">• Carries like a briefcase — 2.4kg system</span></div>
				<div class="border border-white/10 p-4 bg-white/5"><span class="text-sm leading-relaxed">• Metro gates and airline cabins, no debates</span></div>
				<div class="border border-white/10 p-4 bg-white/5"><span class="text-sm leading-relaxed">• 100Wh battery slips into your backpack</span></div>
			</div>
		</section>

		<!-- Positioning copy -->
		<section class="max-w-3xl mb-16">
			<h2 class="text-3xl font-bold tracking-tighter uppercase mb-6">Engineered For Folding Commuter</h2>
			<p class="text-lg opacity-70 leading-relaxed">The Bamboo Flute is our flagship folding platform. At just 18 inches of wheel and a 2.4kg Micro Mid-Drive system, it folds in seconds and carries like a briefcase. The detachable 100Wh battery — IATA-compliant — slips into your backpack for air travel, while the bike rides any metro gate without debate. Built for the modern commuter who moves between cities, not just streets.</p>
			<p class="mt-8 text-sm opacity-50 leading-relaxed">Folds in 3 seconds · Carry-friendly 2.4kg system · System weight 2.4kg · Detachable battery, flight-safe and USB-C ready.</p>
		</section>

		<ProductDetailModules lifestyle={lifestyle} proof={['Folding platform staged for urban and transit use', 'Series reference values clearly separated from final OEM configuration', 'Engineering, validation and certification support available']} />

		<!-- Who It's For -->
		<section class="mb-16 border-l-2 border-industrialOrange pl-6">
			<h2 class="text-xs uppercase tracking-widest opacity-50 mb-3 font-bold">Who It's For</h2>
			<p class="text-lg opacity-80 leading-relaxed">Built for urban business travelers and daily commuters who need a bike that can ride, fold, and fly with them — no parking spot, no garage, no compromise.</p>
		</section>

		<!-- OEM CTA -->
		<section class="p-10 bg-cyberBlue/10 border border-cyberBlue/20 text-center">
			<h2 class="text-2xl font-bold tracking-tighter uppercase mb-4">White-Label The Bamboo Flute</h2>
			<p class="max-w-xl mx-auto opacity-70 mb-8 text-sm leading-relaxed">Custom colors, firmware tuning, and certification support for your market. Our engineering team provides STEP files and integration drawings to qualifying partners.</p>
			<div class="flex justify-center gap-4">
				<a href="/solutions/parts-oem" class="px-8 py-4 bg-industrialOrange text-white font-bold uppercase tracking-widest hover:bg-white hover:text-industrialOrange transition-all">OEM Services</a>
				<a href="/contact" class="px-8 py-4 border border-white font-bold uppercase tracking-widest hover:border-cyberBlue hover:text-cyberBlue transition-all">Request Specs</a>
			</div>
		</section>
	</main>
</Layout>
