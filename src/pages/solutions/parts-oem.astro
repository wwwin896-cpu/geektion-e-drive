---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Parts OEM Services">
	<main class="container mx-auto p-4 py-20">
		<h1 class="text-5xl font-bold mb-12 uppercase tracking-tighter">Parts <span class="text-cyberBlue">OEM</span></h1>
		<div class="grid md:grid-cols-2 gap-16">
			<div>
				<h2 class="text-3xl font-bold tracking-tighter mb-6">Manufacturing Capabilities</h2>
				<p class="opacity-70 mb-8 leading-relaxed">We provide high-end manufacturing services for eBike brands globally. Our facility is equipped with state-of-the-art robotic welding and 5-axis CNC machines.</p>
				<div class="grid grid-cols-2 gap-4">
					<div class="p-6 border border-white/10">
						<h4 class="text-cyberBlue font-bold tracking-tighter mb-2">Forging</h4>
						<p class="text-xs opacity-50 leading-relaxed">6061/7005 Aluminum alloy frames.</p>
					</div>
					<div class="p-6 border border-white/10">
						<h4 class="text-cyberBlue font-bold tracking-tighter mb-2">CNC</h4>
						<p class="text-xs opacity-50 leading-relaxed">Precision motor housings and components.</p>
					</div>
				</div>
			</div>
			<div class="bg-industrialOrange/10 p-12 border border-industrialOrange/20">
				<h3 class="text-2xl font-bold tracking-tighter mb-6 text-industrialOrange uppercase">Start a Project</h3>
				<p class="text-sm mb-8 opacity-80 leading-relaxed">Looking for a manufacturing partner? Our engineering team is ready to assist with prototyping and mass production.</p>
				<a href="/contact" class="inline-block px-8 py-4 bg-industrialOrange text-white font-bold uppercase tracking-widest">Inquiry Portal</a>
			</div>
		</div>
	</main>
</Layout>
